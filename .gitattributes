# Normalize line endings across the repo. Let Git decide text vs binary for anything not
# explicitly listed below, and normalize to LF in the repository (checked out per each rule's
# eol= setting on Windows).
* text=auto

# Explicit text types present in this repo, normalized to CRLF on checkout (the convention
# already used throughout the codebase).
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf
*.md       text eol=crlf
*.json     text eol=crlf
*.ps1      text eol=crlf
